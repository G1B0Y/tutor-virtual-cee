# Copia este archivo como .env y cambia la contraseña. .env no se sube al repo.
POSTGRES_DB=tutor
POSTGRES_USER=tutor
POSTGRES_PASSWORD=cambia-esta-contrasena
ORIGENES_PERMITIDOS=["http://localhost:5173","http://127.0.0.1:5173"]
# Modelos elegidos con el benchmark del 07/11/2026 y los umbrales que propuso para ellos.
# Si cambias EMBEDDINGS_MODELO, cambia también los umbrales (cada modelo tiene su escala) y corre:
#   docker compose exec api python -m app.ingesta reindexar
LLM_MODELO=granite3.3:2b
EMBEDDINGS_MODELO=intfloat/multilingual-e5-small
UMBRAL_DISTANCIA=0.18
UMBRAL_FAQ=0.10
# Búsqueda híbrida: peso de las palabras de la pregunta frente al significado, y fuentes citadas: las que tienen
# un puntaje hasta este margen del mejor (reemplaza a MARGEN_FUENTES, que ya no se usa)
PESO_LEXICO=1.0
MARGEN_PUNTAJE=0.4
# Segundo intento si el modelo se abstiene y el mejor fragmento tiene al menos este puntaje (máximo 2)
PUNTAJE_REINTENTO=1.6
# Parte mínima de cada oración de la respuesta que debe estar en los documentos; si no, se quita
MINIMO_RESPALDO=0.6
# Preguntas de razonamiento (casos, porqués, comparaciones): más fragmentos, más margen, umbral algo más amplio
# y respaldo mínimo menor. Provisionales: calibrar con benchmark/preguntas_sie.json
FRAGMENTOS_RAZONAMIENTO=6
MARGEN_RAZONAMIENTO=0.8
UMBRAL_RAZONAMIENTO=0.20
MINIMO_RESPALDO_RAZONAMIENTO=0.5
# Preguntas por alumno y por minuto (0 = sin límite). CONFIAR_EN_PROXY=true solo detrás de Nginx.
LIMITE_POR_MINUTO=8
CONFIAR_EN_PROXY=false
# Clave para ver las consultas pendientes (cabecera X-Clave-CEE). Vacía = desactivado. Inventa una larga.
CLAVE_CEE=
# Puertos en tu PC (solo 127.0.0.1). Cámbialos si otro programa ya los usa,
# por ejemplo un Ollama instalado en Windows (11434) o un PostgreSQL propio (5432).
# Si cambias PUERTO_API, cambia también VITE_API_URL en frontend/.env.
PUERTO_DB=5432
PUERTO_OLLAMA=11434
PUERTO_API=8000
